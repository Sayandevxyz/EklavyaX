# Environment Variables for Synapse Backend (EklavyaX)
# Copy this file to .env and fill in your actual values

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eklavyax
# Or for local SQLite testing:
# DATABASE_URL=sqlite:///./eklavyax.db

# ─── JWT Security ────────────────────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── AI Provider ─────────────────────────────────────────────────────────────
# Set to "openrouter" (default), "gemini", or "openai"
AI_PROVIDER=openrouter

# OpenRouter API Key (get from https://openrouter.ai/keys)
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=google/gemini-2.5-flash

# Google Gemini API Key (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# ─── Economy Settings ────────────────────────────────────────────────────────
# Cost in EduCoins to use the AI Explain feature
AI_EXPLAIN_COST=10
# Coins refunded if student answers correctly after using AI
AI_REFUND_COINS=5
# Coins awarded for completing a daily streak check-in
STREAK_BONUS_COINS=5
# XP awarded per streak day
STREAK_BONUS_XP=10
# XP awarded when a bounty is completed
BOUNTY_COMPLETION_XP=50

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ─── Redis (Optional) ────────────────────────────────────────────────────────
# Uncomment to enable Redis caching for leaderboards
# REDIS_URL=redis://localhost:6379/0

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development
